// SwitchNiri · niri 26.04 主配置
// 由仓库管理：ln -s <repo>/config/niri/config.kdl ~/.config/niri/config.kdl
// 参考：/usr/share/doc/niri/wiki/Configuration:-Introduction.md

// DMS 的显示器设置写在这里，首次登录后由 DMS 自己生成。
// optional=true：文件不存在只 warn 不失败（26.04 文档 Configuration:-Include.md），
// 而且它仍被监视 —— DMS 之后写出这个文件时 niri 会自动热重载。
// 用绝对路径 + ~ 展开（26.04 起支持），因为本文件是指向仓库的符号链接，
// 相对路径的基准目录取决于 niri 解析的是链接还是目标。
include optional=true "~/.config/niri/dms/outputs.kdl"
// DMS 生成的其他片段：它的设置界面（外观/间距/Alt-Tab/模糊/自定义绑定）就是写这些文件。
// 放在靠前的位置会让它们被下面的 layout/window-rule 覆盖，所以统一放文件末尾（见文件尾部）。


input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }
    // 台机无触摸板，显式关掉
    touchpad {
        off
    }
    // 鼠标（Compx Nearlink 无线 / 硬件 800 DPI）：
    // niri 不写就是 libinput 的 adaptive 曲线 —— 移动越快倍数越高（libinput 上限 3.5 倍），
    // 快速甩动时会明显「过头」。GNOME 那边的真实设置（dconf 实测）是
    // accel-profile 'flat' + speed 0.0，也就是全程 1:1。所以同一只鼠标在 niri 里显得更快，
    // 差别全在这条曲线上，跟 dpi 无关（这台机器没设 MOUSE_DPI，libinput 按 1000 dpi 归一化）。
    // 这里照抄 GNOME 的 flat/0：1 个 mouse count = 1 像素，等价于 Windows 关掉
    // 「提高指针精确度」、指针速度停在 6/11 的 1:1。
    // 要再细调：flat 下 accel-speed 是恒定倍数，越负越慢（-0.2、-0.3…），保存即热重载。
    mouse {
        accel-profile "flat"
        accel-speed 0.0
        // natural-scroll 是「写了才开」的开关，GNOME 那边是关的 → 省略
    }

    // 鼠标移入窗口即聚焦（GNOME 的焦点跟随点击，这里保持默认：不开启）
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // GNOME 蓝 #3584e4，细边框更接近 GNOME 的观感
    focus-ring {
        width 2
        active-color "#3584e4"
        inactive-color "#3d3846"
    }
    border {
        off
    }
}

// 弹窗左上角的“重要快捷键”提示，第一次看完就关掉
hotkey-overlay {
    skip-at-startup
}

// GTK 主题：只影响 niri 会话（GNOME 的 gtk-theme 在 dconf 里，是 MacTahoe-Dark）。
// libadwaita 应用不认这个变量，靠 scripts/gtk-theme-session.sh 换 ~/.config/gtk-4.0 的
// 用户 CSS 实现；那个脚本由下面的 spawn-sh-at-startup 拉起。
environment {
    GTK_THEME "catppuccin-mocha-mauve-standard+default"

    // 登录会话里残留着上一个 GNOME 会话的 ibus 变量（QT_IM_MODULE=ibus、
    // XMODIFIERS=@im=ibus、QT_IM_MODULES=wayland;ibus），niri 会原样继承给子进程，
    // 而 ibus 在 niri 下并没有运行 —— 必须在这里覆盖成 fcitx。
    QT_IM_MODULE "fcitx"
    QT_IM_MODULES "wayland;fcitx"
    XMODIFIERS "@im=fcitx"
}

// 把 GTK4 用户样式切到 Catppuccin（登录 GNOME 时由 autostart 换回 MacTahoe）
spawn-sh-at-startup "~/SwitchNiri/scripts/gtk-theme-session.sh niri"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.0
}

// 圆角 + 裁切（FAQ: How to enable rounded corners for all windows）
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Firefox 画中画默认浮动（随包默认配置里的同款规则）
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Steam 的通知是浮动窗口，挪到右下角（上游 Application-Issues.md 给的规则）
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// 密码管理器不进录屏（Screencasting.md）
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screencast"
}

binds {
    // ── 基础：启动器 / 终端 / 锁屏 / 电源菜单 ──────────────────────────
    Mod+D { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Return { spawn "kitty"; }
    Mod+T { spawn "kitty"; }
    Super+Alt+L { spawn "dms" "ipc" "call" "lock" "lock"; }
    Ctrl+Alt+Delete { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

    // ── 窗口 ────────────────────────────────────────────────────────
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }
    Alt+Tab repeat=false { focus-window-previous; }        // GNOME 肌肉记忆
    Mod+Tab repeat=false { focus-workspace-previous; }
    Mod+V { toggle-window-floating; }
    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }
    Mod+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }
    Mod+W { toggle-column-tabbed-display; }

    // ── 导航（沿用 niri 默认，方向键 + HJKL 双套） ────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // ── 工作区（GNOME 的 Super+1..9 工作区切换）─────────────────────
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // GNOME 是 Super+Shift+N 把窗口丢到工作区 N
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ── 列宽 / 吞并 ────────────────────────────────────────────────
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+C { center-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // ── 屏幕 / 系统 ────────────────────────────────────────────────
    Print { screenshot; }
    Alt+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }

    // ── DMS 面板 ───────────────────────────────────────────────────
    // 2.x 的 dash toggle 需要标签参数（1.4.4 时代无需参数，直接 toggle 会报
    // "Too few arguments provided"）
    Mod+A { spawn "dms" "ipc" "call" "dash" "toggle" "overview"; }  // 负一屏 / 仪表盘
    Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Ctrl+N { spawn "dms" "ipc" "call" "night" "toggle"; }    // 夜灯

    // ── 音量 / 媒体键（随包默认配置的同款写法）─────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // 鼠标滚轮切工作区/列（触控板没有，但滚轮在）
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
}

// ── DMS 托管的片段（位置在最后 = 优先级高于上面的手写值）──────────────
// DMS 的设置界面直接写这几个文件；不 include 的话你在设置里改什么都不生效。
include optional=true "~/.config/niri/dms/colors.kdl"
include optional=true "~/.config/niri/dms/layout.kdl"
include optional=true "~/.config/niri/dms/alttab.kdl"
include optional=true "~/.config/niri/dms/wpblur.kdl"
include optional=true "~/.config/niri/dms/binds.kdl"

// ── Rice 覆盖层（必须最后：KDL 后写赢，见 ADR 0004）─────────────────
include optional=true "~/.config/niri/rice/overrides.kdl"
